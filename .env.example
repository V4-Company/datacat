# See docs/SELF_HOSTING.md for all configuration.
POSTGRES_PASSWORD=
SESSION_SECRET=
PUBLIC_URL=http://localhost:3000
# Optional: token for completing first-run setup from another machine (otherwise one is printed in the log).
DATACAT_SETUP_TOKEN=
# Optional single sign-on with Google (or another OpenID Connect provider via DATACAT_OIDC_ISSUER).
# Enabled when the client id and secret are set; DATACAT_OIDC_ALLOWED_DOMAINS is then required.
DATACAT_OIDC_CLIENT_ID=
DATACAT_OIDC_CLIENT_SECRET=
DATACAT_OIDC_ALLOWED_DOMAINS=
# Empty = true for Google (only Workspace accounts, which carry the hd claim), false for other providers.
DATACAT_OIDC_REQUIRE_HOSTED_DOMAIN=
# Set to 1 when DataCat runs behind one reverse proxy (nginx, Caddy, a load balancer).
DATACAT_TRUST_PROXY=
PORT=3000
DATACAT_RETENTION_DAYS=15
# Telemetry storage: postgres (default, one database) or clickhouse (faster on large data, ~14x less disk).
# With Compose, ClickHouse also needs `--profile clickhouse` and a CLICKHOUSE_PASSWORD.
DATACAT_STORAGE=postgres
CLICKHOUSE_PASSWORD=
# From-source with ClickHouse:
# DATACAT_CLICKHOUSE_URL=http://localhost:8123
# From-source only (URL-encode credentials if needed):
DATABASE_URL=postgresql://datacat:CHANGE_ME@localhost:5432/datacat
# Optional compose agent profile; obtain a key from Organization Settings:
DATACAT_AGENT_API_KEY=
